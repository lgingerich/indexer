# Cargo build output (keep Cargo.lock tracked)
target/

# Local environment files; keep a shareable example
.env
.env.*
!.env.example

# Rust tooling artifacts
*.rs.bk
*.pdb
rustc-ice-*.txt
mutants.out*/

# macOS metadata
.DS_Store

# Project-specific
# Local settings files, which may hold secrets written as values.
*.local.toml
debug

# The local DuckDB store, created by running the indexer.
*.duckdb
