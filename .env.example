# Local development secrets. Copy to `.env` (gitignored), fill in, and load into the
# shell before running: `set -a && . ./.env && set +a`, or `dotenv` in a direnv `.envrc`.
# The indexer reads only variables a settings file names as `{ env = "NAME" }`; these
# are the names `indexer.example.toml` uses. Production injects them from the
# platform's secret manager instead.

INDEXER_HTTP_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
INDEXER_WS_URL=wss://base-mainnet.g.alchemy.com/v2/your-api-key
INDEXER_POSTGRES_URL=postgres://indexer:password@localhost:5432/indexer?sslmode=disable

# Per-chain endpoints, as `indexer.<chain>.toml` names them. An HTTP endpoint for blocks,
# receipts, and logs; a WebSocket one for live heads, which a run with `stop_block` never
# opens.
INDEXER_ETHEREUM_HTTP_URL=https://1.rpc.hypersync.xyz/your-api-token
INDEXER_ETHEREUM_WS_URL=wss://eth-mainnet.example.com/your-api-key
INDEXER_BSC_HTTP_URL=https://56.rpc.hypersync.xyz/your-api-token
INDEXER_BSC_WS_URL=wss://bsc-mainnet.example.com/your-api-key
INDEXER_ROBINHOOD_HTTP_URL=https://4663.rpc.hypersync.xyz/your-api-token
INDEXER_ROBINHOOD_WS_URL=wss://robinhood.example.com/your-api-key
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
